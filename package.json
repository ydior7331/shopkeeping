{
  "name": "kosarar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "import": "node scripts/import.mjs",
    "db:migrate": "wrangler d1 migrations apply kosarar --remote",
    "db:migrate:local": "wrangler d1 migrations apply kosarar --local"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
